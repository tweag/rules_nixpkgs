load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_testonly = 1)

sh_test(
    name = "run-test-invalid-nixpkgs-package",
    timeout = "short",
    srcs = ["test_invalid_nixpkgs_package.sh"],
    data = [
        "//nixpkgs:srcs",
        "//tests/invalid_nixpkgs_package:srcs",
        "@coreutils_static//:bin",
        "@nix_2_34//:bin",
        "@rules_nixpkgs_cc//:srcs",
        "@rules_nixpkgs_core//:srcs",
        "@rules_nixpkgs_java//:srcs",
        "@rules_nixpkgs_nodejs//:srcs",
        "@rules_nixpkgs_posix//:srcs",
        "@rules_nixpkgs_python//:srcs",
        "@rules_nixpkgs_rust//:srcs",
    ],
    # MacOS sandbox fails this test with the following error:
    #   sandbox-exec: sandbox_apply: Operation not permitted
    tags = ["no-sandbox"],
)

cc_binary(
    name = "signature_probe",
    srcs = ["signature_probe.c"],
    linkshared = True,
)

sh_test(
    name = "install_name_tool_signature_test",
    srcs = ["install_name_tool_signature_test.sh"],
    args = [
        "$(location :signature_probe)",
        "$(location @nixpkgs_config_cc_info//:CC_TOOLCHAIN_INFO)",
    ],
    data = [
        ":signature_probe",
        "@nixpkgs_config_cc_info//:CC_TOOLCHAIN_INFO",
    ],
    # tags = ["manual"],
)
